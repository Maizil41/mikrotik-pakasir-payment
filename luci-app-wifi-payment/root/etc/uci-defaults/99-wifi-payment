#!/bin/sh

cd /etc/wifi-payment || exit 1

while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    case "$pkg" in
        \#*) continue ;;
    esac

    if [ -d "node_modules/$pkg" ]; then
        echo "[INFO] $pkg sudah terinstall, melewati..."
    else
        echo "[INFO] Menginstall $pkg..."
        npm install "$pkg" || exit 1
    fi
done < requirements.txt

mkdir -p /etc/crontabs
[ -f /etc/crontabs/root ] || touch /etc/crontabs/root

CRON='* * * * * /usr/bin/payment-check >/dev/null 2>&1'
grep -Fxq "$CRON" /etc/crontabs/root || {
    echo "$CRON" >> /etc/crontabs/root
    /etc/init.d/cron restart
}

rm -f /etc/uci-defaults/99-wifi-payment
rm -f /etc/wifi-payment/requirements.txt